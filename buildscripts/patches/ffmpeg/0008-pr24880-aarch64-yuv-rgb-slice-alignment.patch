index f6dbed3c08..4c12c888c6 100644
--- a/libswscale/Makefile
+++ b/libswscale/Makefile
@@ -53,6 +53,7 @@ TESTPROGS = colorspace                                                  \
             floatimg_cmp                                                \
             pixdesc_query                                               \
             swscale                                                     \
+            unscaled_threaded                                           \
 
 TESTPROGS-$(CONFIG_UNSTABLE) = sws_ops                                  \
                                sws_ops_aarch64                          \
