Subject: [PATCH] swscale/aarch64: align unscaled RGB slices to source chroma

Upstream proposal: https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/24880
Patchwork: https://patchwork.ffmpeg.org/project/ffmpeg/patch/61059/
Includes the upstream threaded conversion FATE regression test.

diff --git a/libswscale/aarch64/swscale_unscaled.c b/libswscale/aarch64/swscale_unscaled.c
index c9041db99f..d11625dbbb 100644
--- a/libswscale/aarch64/swscale_unscaled.c
+++ b/libswscale/aarch64/swscale_unscaled.c
@@ -146,8 +146,10 @@ static int nv24_to_yuv420p_neon_wrapper(SwsInternal *c, const uint8_t *const src
         && c->opts.dst_format == AV_PIX_FMT_##OFMT                                          \
         && !(c->opts.src_h & 1)                                                             \
         && !(c->opts.src_w & 15)                                                            \
-        && !accurate_rnd)                                                                   \
+        && !accurate_rnd) {                                                                 \
         c->convert_unscaled = ifmt##_to_##ofmt##_neon_wrapper;                              \
+        c->dst_slice_align = FFMAX(c->dst_slice_align, 1 << c->chrSrcVSubSample);            \
+    }                                                                                     \
 } while (0)
 
 #define SET_FF_YUVX_TO_ALL_RGBX_FUNC(yuvx, YUVX, accurate_rnd) do {                         \
diff --git a/libswscale/aarch64/yuv2rgb_neon.S b/libswscale/aarch64/yuv2rgb_neon.S
index 734b6dd174..de5c5ce70a 100644
--- a/libswscale/aarch64/yuv2rgb_neon.S
+++ b/libswscale/aarch64/yuv2rgb_neon.S
@@ -941,10 +941,9 @@ endfunc
 // share one chroma row, so the chroma -> RGB offsets (v20-v25) are
 // computed once and applied to both luma rows.
 //
-// Precondition: slice height is even. SET_FF_YUVX_TO_RGBX_FUNC gates
-// on !(src_h & 1); scale_internal()'s macro_height_src check in
-// libswscale/swscale.c rejects any odd srcSliceH for vertically-
-// subsampled sources (chrSrcVSubSample > 0).
+// Precondition: slice height is even. SET_FF_YUVX_TO_RGBX_FUNC checks
+// the frame height and sets dst_slice_align for threaded conversion.
+// scale_internal() also rejects odd input slices for subsampled sources.
 .macro declare_2l_packed ifmt ofmt
 function ff_\ifmt\()_to_\ofmt\()_neon, export=1
         uxtw            widthx, width
-- 
