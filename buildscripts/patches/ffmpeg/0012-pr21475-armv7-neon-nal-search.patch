+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/arm/asm.S"
+
+function ff_nal_find_startcode_neon, export=1
+        sub             r2, r1, r0
+        cmp             r2, #64
+        bls             2f
+1:      sub             r2, r1, r0
+        cmp             r2, #18
+        blo             2f
+        vld1.8          {d0-d1}, [r0]
+        vceq.i8         q0, q0, #0
+        // A last-byte zero remains a candidate for a pair crossing this block.
+        vmov.u8         r3, d1[7]
+        vext.8          q1, q0, q0, #1
+        vand            q0, q0, q1
+        vorr            d0, d0, d1
+        vpmax.u8        d0, d0, d0
+        vpmax.u8        d0, d0, d0
+        vpmax.u8        d0, d0, d0
+        vmov.32         r2, d0[0]
+        orrs            r2, r2, r3
+        bne             2f
+        add             r0, r0, #16
+        b               1b
+        // Reuse the four-byte C detail scan for candidates, short buffers, and tails.
+2:      b               ff_nal_find_startcode_c
+endfunc
diff --git a/libavutil/nal.c b/libavutil/nal.c
index d6e360a..f847c21 100644
--- a/libavutil/nal.c
+++ b/libavutil/nal.c
@@ -27,12 +27,14 @@
 #include "thread.h"
 #if ARCH_AARCH64 && HAVE_NEON
 #include "aarch64/cpu.h"
+#elif ARCH_ARM && HAVE_NEON
+#include "arm/cpu.h"
 #endif
 #include "nal.h"
 
 const uint8_t *ff_nal_find_startcode_c(const uint8_t *p, const uint8_t *end);
 
-#if ARCH_AARCH64 && HAVE_NEON
+#if (ARCH_AARCH64 || ARCH_ARM) && HAVE_NEON
 const uint8_t *ff_nal_find_startcode_neon(const uint8_t *p, const uint8_t *end);
 #endif
 
@@ -67,7 +69,7 @@ static AVOnce nal_func_init_once = AV_ONCE_INIT;
 
 static void nal_find_startcode_init(void)
 {
-#if ARCH_AARCH64 && HAVE_NEON
+#if (ARCH_AARCH64 || ARCH_ARM) && HAVE_NEON
     int cpu_flags = av_get_cpu_flags();
     if (have_neon(cpu_flags))
         nal_find_startcode_func = ff_nal_find_startcode_neon;
