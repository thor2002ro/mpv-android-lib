diff --git a/libswscale/aarch64/ops_jit_llvm.cpp b/libswscale/aarch64/ops_jit_llvm.cpp
index 03ce1b6..624ef69 100644
--- a/libswscale/aarch64/ops_jit_llvm.cpp
+++ b/libswscale/aarch64/ops_jit_llvm.cpp
@@ -18,10 +18,16 @@
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
  */

+#include "config.h"
+
 /* Prevent collision with LLVM's usage of PIC as a parameter name. */
 #undef PIC

 #include <mutex>
+#if ARCH_ARM
+#include <array>
+#include <vector>
+#endif

 #include <llvm/MC/MCAsmBackend.h>
 #include <llvm/MC/MCAsmInfo.h>
@@ -54,6 +60,19 @@ extern "C" {

 using namespace llvm;

+#if ARCH_ARM
+static int publish_code(StringRef bytes, uint8_t **text, size_t *size)
+{
+    *size = bytes.size();
+    *text = (uint8_t *) ff_sws_jit_alloc(*size);
+    if (!*text)
+        return AVERROR(ENOMEM);
+    memcpy(*text, bytes.data(), *size);
+    __builtin___clear_cache((char *) *text, (char *) *text + *size);
+    return ff_sws_jit_protect(*text, *size);
+}
+#endif
+
 /*********************************************************************/
 static void asm_diag_handler(const SMDiagnostic &diag, void *context)
 {
@@ -84,13 +103,33 @@ int ff_sws_jit_assemble_llvm(void *logctx, const char *src,
                              uint8_t **out_text, size_t *out_size,
                              AVBPrint *errstr)
 {
+#if ARCH_ARM
+    static const char triple_name[] = "armv7a-unknown-linux-android";
+    struct CachedCode { std::string source; std::vector<char> bytes; };
+    static std::array<CachedCode, 8> cache;
+    static size_t next = 0;
+    static std::mutex cache_mutex;
+    {
+        std::lock_guard<std::mutex> lock(cache_mutex);
+        for (const auto &entry : cache)
+            if (!entry.bytes.empty() && entry.source == src)
+                return publish_code(StringRef(entry.bytes.data(), entry.bytes.size()), out_text, out_size);
+    }
+#else
     static const char triple_name[] = "aarch64-unknown-linux-gnu";
+#endif

     static std::once_flag initialized;
     std::call_once(initialized, [] {
+#if ARCH_ARM
+        LLVMInitializeARMTargetInfo();
+        LLVMInitializeARMTargetMC();
+        LLVMInitializeARMAsmParser();
+#else
         LLVMInitializeAArch64TargetInfo();
         LLVMInitializeAArch64TargetMC();
         LLVMInitializeAArch64AsmParser();
+#endif
     });

     std::string err;
@@ -211,6 +250,17 @@ int ff_sws_jit_assemble_llvm(void *logctx, const char *src,
             return AVERROR_INVALIDDATA;
         }

+#if ARCH_ARM
+        /* Keep bounded byte copies; each caller still owns a separate W^X mapping. */
+        if (strlen(src) <= 16384 && contents->size() <= 16384) {
+            std::lock_guard<std::mutex> lock(cache_mutex);
+            auto &entry = cache[next++ % cache.size()];
+            entry.source = src;
+            entry.bytes.assign(contents->begin(), contents->end());
+        }
+        return publish_code(*contents, out_text, out_size);
+#else
+
         *out_size = contents->size();
         *out_text = (uint8_t *) ff_sws_jit_alloc(*out_size);
         if (!*out_text)
@@ -221,6 +271,7 @@ int ff_sws_jit_assemble_llvm(void *logctx, const char *src,
         __builtin___clear_cache((char *) *out_text, (char *) *out_text + *out_size);
 #endif
         return ff_sws_jit_protect(*out_text, *out_size);
+#endif
     }

     av_log(logctx, AV_LOG_WARNING, "LLVM JIT: no .text section in assembled output\n");
