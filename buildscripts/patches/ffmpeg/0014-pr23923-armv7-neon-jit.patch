+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config.h"
+#include "libavutil/cpu.h"
+#include "libavutil/bprint.h"
+#include "libavutil/mem.h"
+#include "libavutil/pixdesc.h"
+#include "../jit.h"
+#include "../ops.h"
+#include "../ops_dispatch.h"
+#include "../uops.h"
+#include "../aarch64/ops_jit_llvm.h"
+
+/* q0-q3 hold components; q8-q10 are scratch, q12-q13 hold RGB24 indices.
+ * These are all caller-saved under AAPCS32, leaving d8-d15 untouched. */
+typedef struct ArmJIT {
+    void (*kernel)(const uint8_t *const in[4], uint8_t *const out[4], int blocks);
+    size_t size;
+    SwsCompMask in, out;
+} ArmJIT;
+
+static void constant(AVBPrint *c, int component, unsigned value)
+{
+    av_bprintf(c, "mov r3, #%u\nvdup.8 q%d, r3\n", value, component);
+}
+
+static bool component_mask(SwsCompMask mask)
+{
+    return mask && mask <= SWS_COMP_ALL && !(mask & (mask + 1));
+}
+
+static void memory_op(AVBPrint *c, const SwsUOp *op, bool write, const int *channels)
+{
+    const bool packed = op->uop == SWS_UOP_READ_PACKED || op->uop == SWS_UOP_WRITE_PACKED;
+    const char *verb = write ? "vst" : "vld";
+    const int reg = write ? 8 : 4;
+    const int count = av_popcount(op->mask);
+    if (packed && count > 1) {
+        /* Each structured load/store covers eight pixels: low then high D banks. */
+        for (int half = 0; half < 2; half++) {
+            av_bprintf(c, "%s%d.8 {", verb, count);
+            for (int i = 0; i < count; i++)
+                av_bprintf(c, "%sd%d", i ? "," : "", 2 * i + half);
+            av_bprintf(c, "}, [r%d]!\n", reg);
+        }
+    } else {
+        /* Store directly from the source registers, avoiding permutation moves. */
+        for (int j = 0; j < (channels ? 4 : 1); j++) {
+            for (int i = 0; i < count; i++) {
+                int component = channels ? channels[i] : i;
+                if (channels && component != j)
+                    continue;
+                av_bprintf(c, "%s1.8 {d%d,d%d}, [r%d]%s\n", verb,
+                           2 * component, 2 * component + 1, reg + i,
+                           write && !packed ? "" : "!");
+            }
+        }
+        if (write && !packed) {
+            for (int i = 0; i < count; i++)
+                av_bprintf(c, "add r%d, r%d, #16\n", reg + i, reg + i);
+        }
+    }
+}
+
+static bool planar_permutation(const SwsUOpList *ops, int channels[5])
+{
+    if ((ops->num_ops != 2 && ops->num_ops != 3) ||
+        ops->ops[ops->num_ops - 1].uop != SWS_UOP_WRITE_PLANAR)
+        return false;
+    for (int i = 0; i < 5; i++)
+        channels[i] = i < 4 && (ops->ops[0].mask & SWS_COMP(i)) ? i : -1;
+    if (ops->num_ops == 3) {
+        const SwsUOp *move = &ops->ops[1];
+        if (move->type != SWS_PIXEL_U8 || !move->mask || (move->mask & ~SWS_COMP_ALL) ||
+            (move->uop != SWS_UOP_COPY && move->uop != SWS_UOP_PERMUTE) ||
+            move->par.move.num_moves < 0 || move->par.move.num_moves > SWS_UOP_MOVE_MAX)
+            return false;
+        for (int i = 0; i < move->par.move.num_moves; i++) {
+            int src = move->par.move.src[i], dst = move->par.move.dst[i];
+            if (src < -1 || src > 3 || dst < -1 || dst > 3 || channels[src < 0 ? 4 : src] < 0)
+                return false;
+            channels[dst < 0 ? 4 : dst] = channels[src < 0 ? 4 : src];
+        }
+    }
+    for (int i = 0; i < 4; i++)
+        if ((ops->ops[ops->num_ops - 1].mask & SWS_COMP(i)) && channels[i] < 0)
+            return false;
+    return true;
+}
+static void read_rgb24(AVBPrint *c)
+{
+    av_bprintf(c, "vld1.8 {d16,d17,d18,d19}, [r4]!\n"
+                  "vld1.8 {d20,d21}, [r4]!\n");
+    for (int i = 0; i < 3; i++)
+        av_bprintf(c, "vtbl.8 d%d, {d16,d17,d18}, d%d\n"
+                      "vtbl.8 d%d, {d19,d20,d21}, d%d\n",
+                   2 * i, 24 + i, 2 * i + 1, 24 + i);
+}
+
+static int operation(AVBPrint *c, const SwsUOp *op, SwsCompMask *live)
+{
+    if (op->type != SWS_PIXEL_U8 || !op->mask || (op->mask & ~SWS_COMP_ALL))
+        return AVERROR(ENOTSUP);
+    switch (op->uop) {
+    case SWS_UOP_PERMUTE:
+    case SWS_UOP_COPY: {
+        bool temporary = false;
+        if (op->par.move.num_moves < 0 || op->par.move.num_moves > SWS_UOP_MOVE_MAX)
+            return AVERROR(ENOTSUP);
+        for (int i = 0; i < op->par.move.num_moves; i++) {
+            int src = op->par.move.src[i], dst = op->par.move.dst[i];
+            if (src < -1 || src > 3 || dst < -1 || dst > 3 ||
+                (src < 0 ? !temporary : !(*live & SWS_COMP(src))))
+                return AVERROR(ENOTSUP);
+            /* Physical copies avoid aliases when later ops overwrite one component. */
+            av_bprintf(c, "vmov q%d, q%d\n", dst < 0 ? 8 : dst, src < 0 ? 8 : src);
+            if (dst < 0)
+                temporary = true;
+            else
+                *live |= SWS_COMP(dst);
+        }
+        return 0;
+    }
+    case SWS_UOP_CLEAR:
+        for (int i = 0; i < 4; i++) {
+            if (!(op->mask & SWS_COMP(i)))
+                continue;
+            unsigned value = (op->par.clear.zero & SWS_COMP(i)) ? 0
+                           : (op->par.clear.one & SWS_COMP(i)) ? 255 : op->data.vec4[i].u8;
+            constant(c, i, value);
+        }
+        *live |= op->mask;
+        return 0;
+    case SWS_UOP_LSHIFT:
+    case SWS_UOP_RSHIFT:
+        if (op->mask & ~*live || op->par.shift.amount > 8)
+            return AVERROR(ENOTSUP);
+        if (!op->par.shift.amount)
+            return 0;
+        for (int i = 0; i < 4; i++) {
+            if (!(op->mask & SWS_COMP(i)))
+                continue;
+            if (op->uop == SWS_UOP_LSHIFT && op->par.shift.amount == 8) {
+                av_bprintf(c, "veor q%d, q%d, q%d\n", i, i, i);
+            } else {
+                av_bprintf(c, "%s q%d, q%d, #%u\n",
+                           op->uop == SWS_UOP_LSHIFT ? "vshl.i8" : "vshr.u8",
+                           i, i, op->par.shift.amount);
+            }
+        }
+        return 0;
+    case SWS_UOP_MIN:
+    case SWS_UOP_MAX:
+        if (op->mask & ~*live)
+            return AVERROR(ENOTSUP);
+        constant(c, 9, op->data.scalar.u8);
+        for (int i = 0; i < 4; i++) {
+            if (op->mask & SWS_COMP(i))
+                av_bprintf(c, "%s.u8 q%d, q%d, q9\n", op->uop == SWS_UOP_MIN ? "vmin" : "vmax", i, i);
+        }
+        return 0;
+    default:
+        return AVERROR(ENOTSUP);
+    }
+}
+
+static void arm_jit_free(void *priv)
+{
+    ArmJIT *jit = priv;
+    if (jit) {
+        ff_sws_jit_free((void *)jit->kernel, jit->size);
+        av_free(jit);
+    }
+}
+
+static void arm_jit_process(const SwsOpExec *exec, const void *priv,
+                            int bx_start, int y_start, int bx_end, int y_end)
+{
+    const ArmJIT *jit = priv;
+    const uint8_t *in[4] = { 0 };
+    uint8_t *out[4] = { 0 };
+    const int blocks = bx_end - bx_start;
+    if (blocks <= 0 || y_start >= y_end)
+        return;
+    for (int i = 0; i < 4; i++) {
+        if (jit->in & SWS_COMP(i))
+            in[i] = exec->in[i];
+        if (jit->out & SWS_COMP(i))
+            out[i] = exec->out[i];
+    }
+    bool contiguous = !exec->in_bump_y;
+    for (int i = 0; i < 4; i++) {
+        if ((jit->in & SWS_COMP(i)) && exec->in_bump[i])
+            contiguous = false;
+        if ((jit->out & SWS_COMP(i)) && exec->out_bump[i])
+            contiguous = false;
+    }
+    /* A continuous rectangle needs one kernel dispatch instead of one per row. */
+    int64_t total = (int64_t)blocks * (y_end - (int64_t)y_start);
+    if (contiguous && total <= INT_MAX) {
+        jit->kernel(in, out, total);
+        return;
+    }
+    for (int y = y_start; y < y_end; y++) {
+        jit->kernel(in, out, blocks);
+        const int y_bump = exec->in_bump_y ? exec->in_bump_y[y] : 0;
+        for (int i = 0; i < 4; i++) {
+            if (jit->in & SWS_COMP(i))
+                in[i] += (ptrdiff_t)blocks * exec->block_size_in[i] + exec->in_bump[i]
+                       + (ptrdiff_t)y_bump * exec->in_stride[i];
+            if (jit->out & SWS_COMP(i))
+                out[i] += (ptrdiff_t)blocks * exec->block_size_out[i] + exec->out_bump[i];
+        }
+    }
+}
+
+static int arm_jit_compile_uops(SwsContext *ctx, const SwsUOpList *ops, SwsCompiledOp *out)
+{
+    const SwsUOp *read, *write;
+    SwsCompMask live;
+    int channels[5];
+    bool permute;
+    AVBPrint code, err;
+    uint8_t *text = NULL;
+    size_t text_size = 0;
+    ArmJIT *jit;
+    int ret;
+    if (!(av_get_cpu_flags() & AV_CPU_FLAG_NEON) || !ops || !ops->ops ||
+        ops->num_ops < 2 || ops->num_ops > 128 || ops->pixel_size_max != 1)
+        return AVERROR(ENOTSUP);
+    read = &ops->ops[0];
+    write = &ops->ops[ops->num_ops - 1];
+    if (read->type != SWS_PIXEL_U8 || write->type != SWS_PIXEL_U8 ||
+        (read->uop != SWS_UOP_READ_PLANAR && read->uop != SWS_UOP_READ_PACKED) ||
+        (write->uop != SWS_UOP_WRITE_PLANAR && write->uop != SWS_UOP_WRITE_PACKED) ||
+        !component_mask(read->mask) || !component_mask(write->mask) ||
+        ops->planes_in != (read->uop == SWS_UOP_READ_PACKED ? 1 : read->mask) ||
+        ops->planes_out != (write->uop == SWS_UOP_WRITE_PACKED ? 1 : write->mask))
+        return AVERROR(ENOTSUP);
+    live = read->mask;
+    permute = planar_permutation(ops, channels);
+    av_bprint_init(&code, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&code, ".syntax unified\n.arch armv7-a\n.arm\n.fpu neon\n.text\n.align 2\n"
+                      "cmp r2, #0\nbxle lr\npush {r4-r11}\n");
+    for (int i = 0; i < 4; i++) {
+        if (ops->planes_in & SWS_COMP(i))
+            av_bprintf(&code, "ldr r%d, [r0, #%d]\n", 4 + i, i * 4);
+        if (ops->planes_out & SWS_COMP(i))
+            av_bprintf(&code, "ldr r%d, [r1, #%d]\n", 8 + i, i * 4);
+    }
+    const bool table = permute && read->uop == SWS_UOP_READ_PACKED && read->mask == 7;
+    if (table) {
+        /* Linear loads win on large slices; keep structured loads for small ones. */
+        av_bprintf(&code, "cmp r2, #8192\nblt .Lloop\n"
+                          "adr r3, .Lindices\nvld1.8 {d24,d25,d26}, [r3]\n.Ltable:\n");
+        read_rgb24(&code);
+        memory_op(&code, write, true, channels);
+        av_bprintf(&code, "subs r2, r2, #1\nbne .Ltable\nb .Ldone\n");
+    }
+    av_bprintf(&code, ".Lloop:\n");
+    memory_op(&code, read, false, NULL);
+    if (permute)
+        live = write->mask;
+    for (int i = 1; !permute && i < ops->num_ops - 1; i++) {
+        ret = operation(&code, &ops->ops[i], &live);
+        if (ret < 0)
+            goto free_code;
+    }
+    if (write->mask & ~live) {
+        ret = AVERROR(ENOTSUP);
+        goto free_code;
+    }
+    memory_op(&code, write, true, permute ? channels : NULL);
+    av_bprintf(&code, "subs r2, r2, #1\nbne .Lloop\n.Ldone:\npop {r4-r11}\nbx lr\n");
+    if (table)
+        av_bprintf(&code, ".align 2\n.Lindices:\n"
+                          ".byte 0,3,6,9,12,15,18,21\n"
+                          ".byte 1,4,7,10,13,16,19,22\n"
+                          ".byte 2,5,8,11,14,17,20,23\n");
+    if (!av_bprint_is_complete(&code)) {
+        ret = AVERROR(ENOMEM);
+        goto free_code;
+    }
+    av_bprint_init(&err, 0, AV_BPRINT_SIZE_UNLIMITED);
+    ret = ff_sws_jit_assemble_llvm(ctx, code.str, &text, &text_size, &err);
+    if (ret < 0)
+        av_log(ctx, AV_LOG_DEBUG, "ARMv7 LLVM assembly failed: %s\n", err.str);
+    av_bprint_finalize(&err, NULL);
+    av_bprint_finalize(&code, NULL);
+    if (ret < 0) {
+        ff_sws_jit_free(text, text_size);
+        return ret;
+    }
+    jit = av_mallocz(sizeof(*jit));
+    if (!jit) {
+        ff_sws_jit_free(text, text_size);
+        return AVERROR(ENOMEM);
+    }
+    jit->size = text_size;
+    jit->in = ops->planes_in;
+    jit->out = ops->planes_out;
+    jit->kernel = (void *)text;
+    *out = (SwsCompiledOp) {
+        .priv = jit, .free = arm_jit_free, .func = arm_jit_process,
+        .slice_align = 1, .block_size = 16, .cpu_flags = AV_CPU_FLAG_NEON,
+    };
+    return 0;
+
+free_code:
+    av_bprint_finalize(&code, NULL);
+    return ret;
+}
+
+static int arm_jit_compile(SwsContext *ctx, const SwsOpList *ops, SwsCompiledOp *out)
+{
+    const AVPixFmtDescriptor *src = av_pix_fmt_desc_get(ops->src.format);
+    const AVPixFmtDescriptor *dst = av_pix_fmt_desc_get(ops->dst.format);
+    SwsUOpList *uops;
+    int ret;
+    /* This backend processes a common component grid; chroma resampling belongs to other passes. */
+    if (!src || !dst || src->log2_chroma_w || src->log2_chroma_h ||
+        dst->log2_chroma_w || dst->log2_chroma_h)
+        return AVERROR(ENOTSUP);
+    uops = ff_sws_uop_list_alloc();
+    if (!uops)
+        return AVERROR(ENOMEM);
+    ret = ff_sws_ops_translate(ctx, ops, 0, uops);
+    if (ret >= 0)
+        ret = arm_jit_compile_uops(ctx, uops, out);
+    ff_sws_uop_list_free(&uops);
+    return ret;
+}
+
+const SwsOpBackend backend_arm_jit = {
+    .name = "arm_jit", .flags = SWS_BACKEND_ARM_JIT,
+    .compile = arm_jit_compile, .compile_uops = arm_jit_compile_uops,
+    .hw_format = AV_PIX_FMT_NONE,
+};
