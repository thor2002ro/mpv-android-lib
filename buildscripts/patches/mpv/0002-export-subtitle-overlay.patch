+void cmd_subtitle_overlay_raw(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct mpv_node *out = &cmd->result;
+    struct mp_osd_res res = osd_get_vo_res(mpctx->osd);
+
+    cmd->success = false;
+    if (res.w <= 0 || res.h <= 0) {
+        res.w = cmd->args[1].v.i;
+        res.h = cmd->args[2].v.i;
+        res.display_par = 1.0;
+    }
+    if (res.w <= 0 || res.h <= 0)
+        return;
+
+    struct sub_bitmap_list *subs = osd_render(
+        mpctx->osd, res, mpctx->video_pts, OSD_DRAW_SUB_ONLY,
+        mp_draw_sub_formats);
+    if (!subs)
+        return;
+
+    static const uint64_t FNV64_PRIME = UINT64_C(1099511628211);
+    uint64_t change_id = subs->change_id;
+    change_id = (change_id ^ (uint32_t)res.w) * FNV64_PRIME;
+    change_id = (change_id ^ (uint32_t)res.h) * FNV64_PRIME;
+
+    node_init(out, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(out, "change-id", change_id);
+    node_map_add_int64(out, "canvas-w", res.w);
+    node_map_add_int64(out, "canvas-h", res.h);
+
+    if (change_id == (uint64_t)cmd->args[0].v.i64) {
+        cmd->success = true;
+        talloc_free(subs);
+        return;
+    }
+
+    screenshot_ctx *ctx = mpctx->screenshot_ctx;
+    if (!ctx->subtitle_overlay_cache) {
+        // Scalers own config caches, so free them with the command context
+        // before MPV destroys the config mutex.
+        ctx->subtitle_overlay_cache =
+            mp_draw_sub_alloc(mpctx->command_ctx, mpctx->global);
+    }
+
+    struct mp_rect active[1], modified[1];
+    int num_active = 0, num_modified = 0;
+    struct mp_image *overlay = mp_draw_sub_overlay(
+        ctx->subtitle_overlay_cache, subs,
+        active, MP_ARRAY_SIZE(active), &num_active,
+        modified, MP_ARRAY_SIZE(modified), &num_modified);
+    talloc_free(subs);
+    if (!overlay)
+        return;
+
+    if (!num_active) {
+        node_map_add_int64(out, "w", 0);
+        node_map_add_int64(out, "h", 0);
+        cmd->success = true;
+        return;
+    }
+
+    struct mp_rect rc = active[0];
+    int width = mp_rect_w(rc);
+    int height = mp_rect_h(rc);
+    size_t stride = width * 4;
+    size_t size = stride * height;
+
+    node_map_add_int64(out, "x", rc.x0);
+    node_map_add_int64(out, "y", rc.y0);
+    node_map_add_int64(out, "w", width);
+    node_map_add_int64(out, "h", height);
+    node_map_add_int64(out, "stride", stride);
+    node_map_add_string(out, "format", "bgra");
+
+    struct mpv_byte_array *ba =
+        node_map_add(out, "data", MPV_FORMAT_BYTE_ARRAY)->u.ba;
+    uint8_t *data = talloc_size(ba, size);
+    if (!data)
+        return;
+    for (int y = 0; y < height; y++) {
+        memcpy(data + y * stride,
+               mp_image_pixel_ptr(overlay, 0, rc.x0, rc.y0 + y), stride);
+    }
+    *ba = (struct mpv_byte_array){.data = data, .size = size};
+    cmd->success = true;
+}
