diff --git a/demux/dovi_profile_convert.c b/demux/dovi_profile_convert.c
new file mode 100644
index 000000000..2ecc5b9cd
--- /dev/null
+++ b/demux/dovi_profile_convert.c
@@ -0,0 +1,320 @@
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <libavcodec/codec_par.h>
+#include <libavcodec/packet.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/intreadwrite.h>
+
+#include <dovi.h>
+
+#include "common/common.h"
+#include "demux.h"
+#include "dovi_profile_convert.h"
+#include "packet.h"
+#include "stheader.h"
+
+static uint32_t packet_source_base(struct demux_packet *packet,
+                                   uint32_t configured_base)
+{
+    size_t size = 0;
+    if (av_packet_get_side_data(packet->avpacket,
+                               AV_PKT_DATA_DYNAMIC_HDR10_PLUS, &size))
+        return DOVI_PRESENTATION_HDR10_PLUS;
+    return configured_base;
+}
+
+static AVDOVIDecoderConfigurationRecord normalized_config(
+    const AVDOVIDecoderConfigurationRecord *source)
+{
+    AVDOVIDecoderConfigurationRecord cfg = {0};
+    if (source)
+        cfg = *source;
+    if (cfg.dv_version_major == 0)
+        cfg.dv_version_major = 1;
+    cfg.rpu_present_flag = 1;
+    cfg.bl_present_flag = 1;
+    return cfg;
+}
+
+static bool configure_presentation(AVDOVIDecoderConfigurationRecord *cfg,
+                                   uint32_t presentation)
+{
+    cfg->rpu_present_flag = 1;
+    cfg->bl_present_flag = 1;
+    cfg->el_present_flag = 0;
+
+    switch (presentation) {
+    case DOVI_PRESENTATION_PROFILE_5:
+        cfg->dv_profile = 5;
+        cfg->dv_bl_signal_compatibility_id = 0;
+        return true;
+    case DOVI_PRESENTATION_PROFILE_7_MEL:
+    case DOVI_PRESENTATION_PROFILE_7_FEL:
+        cfg->dv_profile = 7;
+        cfg->el_present_flag = 1;
+        if (cfg->dv_bl_signal_compatibility_id == 0)
+            cfg->dv_bl_signal_compatibility_id = 6;
+        return true;
+    case DOVI_PRESENTATION_PROFILE_8_1:
+        cfg->dv_profile = 8;
+        cfg->dv_bl_signal_compatibility_id = 1;
+        return true;
+    case DOVI_PRESENTATION_PROFILE_8_4:
+        cfg->dv_profile = 8;
+        cfg->dv_bl_signal_compatibility_id = 4;
+        return true;
+    default:
+        return false;
+    }
+}
+
+static uint32_t source_presentation(
+    const AVDOVIDecoderConfigurationRecord *source)
+{
+    if (!source)
+        return DOVI_PRESENTATION_UNKNOWN;
+    switch (source->dv_profile) {
+    case 5:
+        return DOVI_PRESENTATION_PROFILE_5;
+    case 7:
+        return DOVI_PRESENTATION_PROFILE_7_FEL;
+    case 8:
+        if (source->dv_bl_signal_compatibility_id == 1)
+            return DOVI_PRESENTATION_PROFILE_8_1;
+        if (source->dv_bl_signal_compatibility_id == 4)
+            return DOVI_PRESENTATION_PROFILE_8_4;
+        return DOVI_PRESENTATION_UNKNOWN;
+    default:
+        return DOVI_PRESENTATION_UNKNOWN;
+    }
+}
+
+static uint32_t requested_presentation(
+    const dovi_transform_request *request,
+    const AVDOVIDecoderConfigurationRecord *source)
+{
+    switch (request->target) {
+    case DOVI_TARGET_LOSSLESS_REWRITE:
+        return source_presentation(source);
+    case DOVI_TARGET_MEL:
+        return DOVI_PRESENTATION_PROFILE_7_MEL;
+    case DOVI_TARGET_PROFILE_8_1:
+    case DOVI_TARGET_PROFILE_8_1_PRESERVE_MAPPING:
+        return DOVI_PRESENTATION_PROFILE_8_1;
+    case DOVI_TARGET_PROFILE_8_4:
+        return DOVI_PRESENTATION_PROFILE_8_4;
+    case DOVI_TARGET_SOURCE_BASE_PRESENTATION:
+        return DOVI_PRESENTATION_UNKNOWN;
+    default:
+        return DOVI_PRESENTATION_UNKNOWN;
+    }
+}
+
+static void remove_side_data(AVPacketSideData *side_data, int *count,
+                             enum AVPacketSideDataType type)
+{
+    av_packet_side_data_remove(side_data, count, type);
+}
+
+bool mp_dovi_prepare_stream(
+    struct sh_stream *stream,
+    const AVDOVIDecoderConfigurationRecord *source_config,
+    const dovi_transform_request *request)
+{
+    if (!stream || !stream->codec || !source_config || !request)
+        return false;
+
+    AVCodecParameters *codecpar = stream->codec->lav_codecpar;
+    if (request->target == DOVI_TARGET_SOURCE_BASE_PRESENTATION) {
+        stream->codec->dovi = false;
+        stream->codec->dv_profile = 0;
+        stream->codec->dv_level = 0;
+        stream->codec->dv_el_present = false;
+        if (codecpar)
+            remove_side_data(codecpar->coded_side_data,
+                             &codecpar->nb_coded_side_data,
+                             AV_PKT_DATA_DOVI_CONF);
+        return true;
+    }
+
+    const uint32_t presentation = requested_presentation(request, source_config);
+    AVDOVIDecoderConfigurationRecord cfg = normalized_config(source_config);
+    if (request->target != DOVI_TARGET_LOSSLESS_REWRITE &&
+        !configure_presentation(&cfg, presentation))
+        return false;
+
+    if (codecpar) {
+        const AVPacketSideData *existing = av_packet_side_data_get(
+            codecpar->coded_side_data, codecpar->nb_coded_side_data,
+            AV_PKT_DATA_DOVI_CONF);
+        if (existing) {
+            if (existing->size < sizeof(cfg))
+                return false;
+            memcpy(existing->data, &cfg, sizeof(cfg));
+        } else {
+            AVPacketSideData *created = av_packet_side_data_new(
+                &codecpar->coded_side_data, &codecpar->nb_coded_side_data,
+                AV_PKT_DATA_DOVI_CONF, sizeof(cfg), 0);
+            if (!created)
+                return false;
+            memcpy(created->data, &cfg, sizeof(cfg));
+        }
+    }
+
+    stream->codec->dovi = true;
+    stream->codec->dv_profile = cfg.dv_profile;
+    stream->codec->dv_level = cfg.dv_level;
+    stream->codec->dv_el_present = cfg.bl_present_flag && cfg.el_present_flag;
+    return true;
+}
+
+static bool output_matches_request(uint32_t output,
+                                   uint32_t source_base,
+                                   const dovi_transform_request *request,
+                                   const AVDOVIDecoderConfigurationRecord *source_config)
+{
+    switch (request->target) {
+    case DOVI_TARGET_LOSSLESS_REWRITE:
+        if (source_config->dv_profile == 7)
+            return output == DOVI_PRESENTATION_PROFILE_7_MEL ||
+                   output == DOVI_PRESENTATION_PROFILE_7_FEL;
+        return output == source_presentation(source_config);
+    case DOVI_TARGET_MEL:
+        return output == DOVI_PRESENTATION_PROFILE_7_MEL;
+    case DOVI_TARGET_PROFILE_8_1:
+    case DOVI_TARGET_PROFILE_8_1_PRESERVE_MAPPING:
+        return output == DOVI_PRESENTATION_PROFILE_8_1;
+    case DOVI_TARGET_PROFILE_8_4:
+        return output == DOVI_PRESENTATION_PROFILE_8_4;
+    case DOVI_TARGET_SOURCE_BASE_PRESENTATION:
+        return source_base != DOVI_PRESENTATION_UNKNOWN && output == source_base;
+    default:
+        return false;
+    }
+}
+
+static bool update_packet_presentation(
+    struct demux_packet *packet,
+    uint32_t presentation,
+    const AVDOVIDecoderConfigurationRecord *source_config,
+    const dovi_transform_request *request)
+{
+    if (presentation == DOVI_PRESENTATION_HDR10 ||
+        presentation == DOVI_PRESENTATION_HDR10_PLUS ||
+        presentation == DOVI_PRESENTATION_HLG)
+    {
+        remove_side_data(packet->avpacket->side_data,
+                         &packet->avpacket->side_data_elems,
+                         AV_PKT_DATA_DOVI_CONF);
+        return true;
+    }
+
+    AVDOVIDecoderConfigurationRecord cfg = normalized_config(source_config);
+    if (request->target != DOVI_TARGET_LOSSLESS_REWRITE &&
+        !configure_presentation(&cfg, presentation))
+        return false;
+
+    size_t size = 0;
+    uint8_t *data = av_packet_get_side_data(
+        packet->avpacket, AV_PKT_DATA_DOVI_CONF, &size);
+    if (data && size < sizeof(cfg)) {
+        remove_side_data(packet->avpacket->side_data,
+                         &packet->avpacket->side_data_elems,
+                         AV_PKT_DATA_DOVI_CONF);
+        data = NULL;
+    }
+    if (!data) {
+        data = av_packet_new_side_data(packet->avpacket,
+                                       AV_PKT_DATA_DOVI_CONF,
+                                       sizeof(cfg));
+        if (!data)
+            return false;
+    }
+    memcpy(data, &cfg, sizeof(cfg));
+    return true;
+}
+
+bool mp_dovi_transform_packet(
+    struct demuxer *demuxer,
+    struct demux_packet **packet,
+    const dovi_transform_request *request,
+    uint64_t generation,
+    uint32_t source_base_presentation,
+    const AVDOVIDecoderConfigurationRecord *source_config)
+{
+    struct demux_packet *source = *packet;
+    const uint8_t *supplemental = NULL;
+    size_t supplemental_size = 0;
+    size_t side_data_size = 0;
+    const uint8_t *side_data = av_packet_get_side_data(
+        source->avpacket, AV_PKT_DATA_MATROSKA_BLOCKADDITIONAL, &side_data_size);
+    if (side_data && side_data_size > 8 && AV_RB64(side_data) == 1) {
+        supplemental = side_data + 8;
+        supplemental_size = side_data_size - 8;
+    }
+
+    const dovi_sample sample = {
+        .struct_size = sizeof(sample),
+        .framing = DOVI_FRAMING_AUTO,
+        .source_base_presentation = packet_source_base(source,
+                                                        source_base_presentation),
+        .data = source->buffer,
+        .data_size = source->len,
+        .supplemental_rpu = supplemental,
+        .supplemental_rpu_size = supplemental_size,
+    };
+    dovi_transform_info info = {0};
+    dovi_owned_buffer output = {0};
+    dovi_status status = dovi_transform_sample_alloc(&sample, request,
+                                                     &output, &info);
+    if (status != DOVI_OK)
+        goto fail;
+    if (output.size == 0 || output.size > SIZE_MAX ||
+        !output_matches_request(info.output_presentation,
+                                sample.source_base_presentation,
+                                request, source_config))
+    {
+        status = DOVI_INTERNAL_ERROR;
+        goto fail;
+    }
+
+    struct demux_packet *converted = new_demux_packet(demuxer->packet_pool,
+                                                       output.size);
+    if (!converted) {
+        status = DOVI_INTERNAL_ERROR;
+        goto fail;
+    }
+
+    memcpy(converted->buffer, output.data, output.size);
+    if (av_packet_copy_props(converted->avpacket, source->avpacket) < 0 ||
+        !update_packet_presentation(converted,
+                                    info.output_presentation,
+                                    source_config, request))
+    {
+        talloc_free(converted);
+        status = DOVI_INTERNAL_ERROR;
+        goto fail;
+    }
+
+    if (supplemental)
+        remove_side_data(converted->avpacket->side_data,
+                         &converted->avpacket->side_data_elems,
+                         AV_PKT_DATA_MATROSKA_BLOCKADDITIONAL);
+
+    demux_packet_copy_attribs(converted, source);
+    dovi_record_mpv_transform_v3(generation,
+                                 info.input_presentation,
+                                 info.output_presentation);
+    dovi_owned_buffer_free(&output);
+    talloc_free(source);
+    *packet = converted;
+    return true;
+
+fail:
+    dovi_owned_buffer_free(&output);
+    dovi_record_mpv_error_v3(generation, status);
+    MP_ERR(demuxer, "Dolby Vision transform failed with status %d\n", status);
+    return false;
+}
