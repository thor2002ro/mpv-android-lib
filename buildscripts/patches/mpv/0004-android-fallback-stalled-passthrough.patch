diff --git a/audio/out/ao_audiotrack_passthrough.h b/audio/out/ao_audiotrack_passthrough.h
new file mode 100644
index 0000000000000000000000000000000000000000..d9e824e5e20c953d82696c0baad611a202606a02
--- /dev/null
+++ b/audio/out/ao_audiotrack_passthrough.h
@@ -0,0 +1,69 @@
+#ifndef MP_AUDIOTRACK_PASSTHROUGH_H_
+#define MP_AUDIOTRACK_PASSTHROUGH_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MP_AUDIOTRACK_PASSTHROUGH_TIMEOUT_NS 2000000000LL
+
+enum mp_audiotrack_passthrough_result {
+    MP_AUDIOTRACK_PASSTHROUGH_PENDING,
+    MP_AUDIOTRACK_PASSTHROUGH_CONFIRMED,
+    MP_AUDIOTRACK_PASSTHROUGH_FAILED,
+};
+
+struct mp_audiotrack_passthrough_watchdog {
+    int64_t last_active_at;
+    int64_t active_elapsed;
+    bool active;
+    bool accepted_data;
+    enum mp_audiotrack_passthrough_result result;
+};
+
+static inline bool mp_audiotrack_passthrough_watchdog_needs_probe(
+    const struct mp_audiotrack_passthrough_watchdog *watchdog,
+    int requested_bytes)
+{
+    return requested_bytes > 0 &&
+           watchdog->result == MP_AUDIOTRACK_PASSTHROUGH_PENDING;
+}
+
+static inline bool mp_audiotrack_passthrough_write_needs_fallback(
+    bool passthrough, int written_bytes)
+{
+    return passthrough && written_bytes < 0;
+}
+
+static inline enum mp_audiotrack_passthrough_result
+mp_audiotrack_passthrough_watchdog_update(
+    struct mp_audiotrack_passthrough_watchdog *watchdog,
+    bool passthrough, int requested_bytes, int written_bytes,
+    uint32_t playhead, int64_t now)
+{
+    if (!passthrough || watchdog->result != MP_AUDIOTRACK_PASSTHROUGH_PENDING)
+        return watchdog->result;
+
+    if (requested_bytes <= 0) {
+        watchdog->active = false;
+        return watchdog->result;
+    }
+
+    if (watchdog->active)
+        watchdog->active_elapsed += now - watchdog->last_active_at;
+    watchdog->active = true;
+    watchdog->last_active_at = now;
+
+    if (written_bytes > 0)
+        watchdog->accepted_data = true;
+
+    if (watchdog->accepted_data && playhead > 0) {
+        watchdog->result = MP_AUDIOTRACK_PASSTHROUGH_CONFIRMED;
+    } else if (watchdog->active_elapsed >=
+               MP_AUDIOTRACK_PASSTHROUGH_TIMEOUT_NS) {
+        watchdog->result = MP_AUDIOTRACK_PASSTHROUGH_FAILED;
+    }
+
+    return watchdog->result;
+}
+
+#endif
